+fn proportional_card_width(client_width: i16, monitor_width: u16) -> i32 {
+    let available_width = (i32::from(monitor_width) * 9 / 10 - 150).max(320);
+    let full_width_card = ((available_width - 24) / 4).max(80);
+    let ratio = f64::from(client_width.max(1)) / f64::from(monitor_width.max(1));
+    ((ratio * f64::from(full_width_card)).round() as i32).clamp(80, full_width_card)
+}
