+fn nth_child(parent: &gtk::Box, index: usize) -> Option<gtk::Widget> {
+    let mut child = parent.first_child();
+    for _ in 0..index {
+        child = child.and_then(|widget| widget.next_sibling());
+    }
+    child
+}
