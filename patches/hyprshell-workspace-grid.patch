+fn grid_rows(data: &HyprlandData) -> Vec<(WorkspaceId, Vec<(ClientId, &core_lib::ClientData)>)> {
+    data.workspaces
+        .iter()
+        .filter(|(workspace, ws)| *workspace > 0 && ws.any_client_enabled)
+        .filter_map(|(workspace, _)| {
+            let clients = data
+                .clients
+                .iter()
+                .filter(|(_, client)| client.enabled && client.workspace == *workspace)
+                .map(|(id, client)| (*id, client))
+                .collect::<Vec<_>>();
+            (!clients.is_empty()).then_some((*workspace, clients))
+        })
+        .collect()
+}
+
+fn active_column(data: &HyprlandData, active: Active) -> usize {
+    grid_rows(data)
+        .iter()
+        .find(|(workspace, _)| *workspace == active.workspace)
+        .and_then(|(_, clients)| {
+            active
+                .client
+                .and_then(|active| clients.iter().position(|(id, _)| *id == active))
+        })
+        .unwrap_or(0)
+}
+
+fn find_grid_client(
+    direction: Direction,
+    data: &HyprlandData,
+    active: Active,
+    preferred_column: usize,
+) -> (Active, usize) {
+    let rows = grid_rows(data);
+    if rows.is_empty() {
+        return (active, preferred_column);
+    }
+
+    let row = rows
+        .iter()
+        .position(|(workspace, _)| *workspace == active.workspace)
+        .unwrap_or(0);
+    let current_column = active
+        .client
+        .and_then(|active| rows[row].1.iter().position(|(id, _)| *id == active))
+        .unwrap_or(0);
+
+    let (next_row, requested_column, next_preferred) = match direction {
+        Direction::Left => (
+            row,
+            current_column.saturating_sub(1),
+            current_column.saturating_sub(1),
+        ),
+        Direction::Right => {
+            let column = (current_column + 1).min(rows[row].1.len() - 1);
+            (row, column, column)
+        }
+        Direction::Up => (row.saturating_sub(1), preferred_column, preferred_column),
+        Direction::Down => (
+            (row + 1).min(rows.len() - 1),
+            preferred_column,
+            preferred_column,
+        ),
+    };
+    let column = requested_column.min(rows[next_row].1.len() - 1);
+    let (id, client) = rows[next_row].1[column];
+    (
+        Active {
+            client: Some(id),
+            workspace: rows[next_row].0,
+            monitor: client.monitor,
+        },
+        next_preferred,
+    )
+}
